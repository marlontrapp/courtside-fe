# Browser-facing API base. Leave empty in local/dev so Vite can proxy
# /api and /api-auth to CourtControl (see vite.config.ts).
VITE_API_BASE_URL=

# Where the Vite dev proxy sends /api and /api-auth.
# Default is http://127.0.0.1:8000 — change if another app owns that port
# (e.g. run CourtControl with RUN_ADDR=127.0.0.1:8001).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
